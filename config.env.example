# Copy to ~/.config/eu4-mcp/config.env (or point EU4_MCP_CONFIG at it). Plain KEY=value lines; real environment variables win.
# Read by the tools/*.sh scripts and by the Python modules. Everything is optional; the values below are the defaults.
#EU4_GAME_DIR=$HOME/games/eu4              # your game install (contains the `eu4` binary and `map/`, `common/`)
#EU4_USER_DIR=$HOME/.local/share/Paradox Interactive/Europa Universalis IV   # saves live here
#EU4_MCP_STATE=$HOME/.config/eu4-mcp       # hook socket, X cookie, snapshots
#EU4_MCP_NOTES=$HOME/.local/share/eu4-mcp/notes   # strategist notes; play log and archive sit next to it
#EU4_MCP_CACHE=$HOME/.cache/eu4-mcp        # parsed game-data cache
#EU4_DISPLAY=:99                           # X display of the game
#EU4_BIND=127.0.0.1                        # watch page + viewer listen address (0.0.0.0 = whole LAN: no login, trusted network only)
#EU4_HOST=127.0.0.1                        # host name printed in links (set when EU4_BIND is 0.0.0.0)
#EU4_WATCH_PORT=6081
#EU4_VNC_PORT=6080
#EU4_DISCORD_PORT=6082
#EU4_DISCORD_DISPLAY=:98
#EU4_XORG_CONF=                            # xorg.conf for tools/display.sh (see display/README.md)
#EU4_XORG_VT=                              # e.g. vt8
#EU4_PLAYER_SESSION=eu4-player             # tmux session of the playing Claude
#EU4_PLAYER_PROMPT=                        # file with the player prompt (copy tools/player_prompt.example.txt)
#EU4_ENCODER=                              # ffmpeg video encoder options for the stream, default NVENC H.264
#EU4_MCP_REVANCHISM=                       # 1 = enable the optional revanchism cheat (off by default)
